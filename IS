-- [7] ESP - Thấy player qua tường
local ESPObjects = {}
local function createESP(player)
    if player == LP then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_" .. player.Name
    billboard.Size = UDim2.new(0, 120, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true

    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Size = UDim2.new(1, 0, 0.6, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 13
    nameLabel.Text = "⚔ " .. player.Name

    local hpLabel = Instance.new("TextLabel", billboard)
    hpLabel.Size = UDim2.new(1, 0, 0.4, 0)
    hpLabel.Position = UDim2.new(0, 0, 0.6, 0)
    hpLabel.BackgroundTransparency = 1
    hpLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    hpLabel.TextStrokeTransparency = 0
    hpLabel.Font = Enum.Font.Gotham
    hpLabel.TextSize = 11
    hpLabel.Text = "HP: ?"

    ESPObjects[player] = billboard

    RunService.Heartbeat:Connect(function()
        if not CFG.ESP then
            billboard.Parent = nil
            return
        end
        if player.Character and player.Character:FindFirstChild("Head") then
            billboard.Parent = player.Character.Head
            local h = player.Character:FindFirstChild("Humanoid")
            if h then
                hpLabel.Text = string.format("HP: %d/%d", math.floor(h.Health), math.floor(h.MaxHealth))
            end
        else
            billboard.Parent = nil
        end
    end)
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p)
    if ESPObjects[p] then ESPObjects[p]:Destroy() end
end)
for _, p in pairs(Players:GetPlayers()) do createESP(p) end

-- [8] AUTO FARM - Tìm mob/dungeon và tấn công
local function findNearestMob()
    local nearest, dist = nil, CFG.FarmRange
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= Char then
            local hum = obj:FindFirstChild("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if hum and hum.Health > 0 and root then
                local d = (Root.Position - root.Position).Magnitude
                if d < dist then
                    nearest = root
                    dist = d
                end
            end
        end
    end
    return nearest
end

local farmLoop
local function startAutoFarm()
    if farmLoop then return end
    farmLoop = task.spawn(function()
        while CFG.AutoFarm do
            if Root and Char then
                local mob = findNearestMob()
                if mob then
                    -- Teleport sát mob
                    Root.CFrame = mob.CFrame * CFrame.new(0, 0, 3)
                    -- Click chuột để attack
                    local inputObj = Instance.new("InputObject")
                    inputObj.UserInputType = Enum.UserInputType.MouseButton1
                    UserInputService.InputBegan:Fire(inputObj, false)
                    task.wait(0.05)
                    UserInputService.InputEnded:Fire(inputObj, false)
                end
            end
            task.wait(0.1)
        end
        farmLoop = nil
    end)
end

-- [9] AUTO COLLECT ITEMS
local function autoCollect()
    task.spawn(function()
        while CFG.AutoCollect do
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (
                    obj.Name:lower():find("item") or
                    obj.Name:lower():find("drop") or
                    obj.Name:lower():find("loot") or
                    obj.Name:lower():find("crystal") or
                    obj.Name:lower():find("coin") or
                    obj.Name:lower():find("soul") or
                    obj.Name:lower():find("shard") or
                    obj.Name:lower():find("ore") or
                    obj.Name:lower():find("gem")
                ) then
                    if Root then
                        local d = (Root.Position - obj.Position).Magnitude
                        if d < 60 then
                            Root.CFrame = CFrame.new(obj.Position)
                            task.wait(0.05)
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

