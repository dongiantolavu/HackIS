local function makeToggle(parent, labelText, configKey, onEnable, onDisable)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 210, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Text = "  " .. labelText .. "   [ TẮT ]"
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local dot = Instance.new("Frame", btn)
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.Position = UDim2.new(1, -20, 0.5, -5)
    dot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    dot.BorderSizePixel = 0
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    btn.MouseButton1Click:Connect(function()
        CFG[configKey] = not CFG[configKey]
        if CFG[configKey] then
            btn.BackgroundColor3 = Color3.fromRGB(140, 10, 10)
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.Text = "  " .. labelText .. "   [ BẬT ]"
            dot.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
            if onEnable then onEnable() end
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Text = "  " .. labelText .. "   [ TẮT ]"
            dot.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            if onDisable then onDisable() end
        end
    end)
    return btn
end

local function makeSectionLabel(parent, text)
